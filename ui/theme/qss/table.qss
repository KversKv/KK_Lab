/* table.qss — 表格/树视图样式（TestPlanView、ResultTable、GroupsTableEditor）
   注意：不在 QTableView/QTreeView 选择器上设 color（调色板由 delegate 的
   ForegroundRole 逐项控制），避免重蹈"全局 QSS 盖掉逐项 setForeground"的坑。 */

QTableView, QTreeView {
    background-color: $surface_input;
    alternate-background-color: $surface_raised;
    border: 1px solid $border_default;
    border-radius: $radius_md;
    gridline-color: $border_subtle;
    selection-background-color: $border_default;
    selection-color: $text_primary;
    font-size: $font_body;
    outline: none;
}
QTableView::item, QTreeView::item {
    /* min == max 钉死行高：hover/selected 态 sizeHint 重算时行不会被撑高溢出 */
    min-height: $table_row_h;
    max-height: $table_row_h;
    padding: 0 $space_1;
    border: none;
}
/* 测试项勾选框（参考 consumption_test Reset 勾选框 SVG 效果） */
QTreeView::indicator {
    image: url("$uncheck_svg");
}
QTreeView::indicator:checked {
    image: url("$check_svg");
}
QTreeView::indicator:disabled {
    opacity: 0.4;
}
/* 独立 QCheckBox（如 DUT 配置「高低温测试」）复用同一套 SVG，避免 Qt 默认勾选框
   在暗色背景上显示异常。table.qss 经 apply_qss 注入子页根 widget 后作用于子树。 */
QCheckBox::indicator {
    width: 16px;
    height: 16px;
    image: url("$uncheck_svg");
}
QCheckBox::indicator:checked {
    image: url("$check_svg");
}
QCheckBox::indicator:disabled {
    opacity: 0.4;
}
QTableView::item:selected, QTreeView::item:selected {
    background-color: $border_default;
    color: $text_primary;
}
QTableView::item:hover, QTreeView::item:hover {
    background-color: $border_subtle;
}

QHeaderView::section {
    background-color: $surface_raised;
    color: $text_muted;
    border: none;
    border-right: 1px solid $border_subtle;
    border-bottom: 1px solid $border_default;
    padding: $space_1 $space_2;
    font-size: $font_caption;
    font-weight: 600;
}
QHeaderView::section:first {
    border-left: none;
}

QTableCornerButton::section {
    background-color: $surface_raised;
    border: none;
    border-bottom: 1px solid $border_default;
}

/* 参数列齿轮按钮（ParamButtonDelegate 内嵌控件时用） */
QPushButton#paramBtn {
    background-color: transparent;
    border: 1px solid $border_default;
    border-radius: $radius_sm;
    color: $text_muted;
    font-size: $font_caption;
    padding: 0 $space_2;
    min-height: $space_4;
    max-height: $space_4;
}
QPushButton#paramBtn:hover {
    color: $text_secondary;
    border-color: $border_strong;
}
QPushButton#paramBtn[customized="true"] {
    color: $state_info_fg;
    border-color: $state_info_border;
}

/* ---------- 测试项/结果面板内表格：去自身边框透底 ----------
   面板外层（QSplitter 相邻卡片 / DetailDock Tab pane）已提供外框，
   内嵌表格再去边框，消除"表格边框与容器边框重叠"的双线。 */
#testPlanPanel QTreeView,
#resultTablePanel QTableView {
    background: transparent;
    border: none;
    border-radius: 0;
}
