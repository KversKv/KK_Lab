/* dialog.qss — 弹窗样式（ItemParamsDialog / ConfigManagerDialog 等）
   由 legacy DIALOG_QSS 迁移而来，选择器与视觉保持一致，裸色值全部 token 化。 */

QDialog {
    background-color: $surface_page;
    color: $text_secondary;
}
QLabel {
    color: $text_secondary;
    background: transparent;
}
QLabel#dlgFieldLabel {
    color: $text_muted;
    font-size: $font_caption;
}
QLabel#dlgHint {
    color: $text_disabled;
    font-size: $font_caption;
}
QLabel[role="caption"] {
    color: $text_muted;
    font-size: $font_caption;
}
QLineEdit, QSpinBox, QDoubleSpinBox {
    background-color: $surface_input;
    border: 1px solid $border_default;
    border-radius: $radius_sm;
    padding: $space_1 $space_2;
    color: $text_secondary;
    min-height: $control_h_compact_box;
}
QLineEdit:hover, QSpinBox:hover, QDoubleSpinBox:hover {
    border-color: $border_strong;
}
QLineEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus {
    border-color: $border_focus;
}
QLineEdit[invalid="true"], QSpinBox[invalid="true"], QDoubleSpinBox[invalid="true"] {
    border-color: $state_error_fg;
}
QLineEdit::placeholder {
    color: $text_disabled;
}
QComboBox {
    background-color: $surface_input;
    border: 1px solid $border_default;
    border-radius: $radius_sm;
    padding: $space_1 $space_2;
    color: $text_secondary;
    min-height: $control_h_compact_box;
}
QComboBox:hover {
    border-color: $border_strong;
}
QComboBox::drop-down {
    border: none;
    width: $space_4;
}
QComboBox QAbstractItemView {
    background-color: $surface_input;
    border: 1px solid $border_default;
    color: $text_secondary;
    selection-background-color: $surface_raised;
}
QPushButton {
    background-color: $surface_card;
    border: 1px solid $border_strong;
    border-radius: $radius_md;
    padding: $space_1 $space_3;
    color: $text_secondary;
    min-height: $control_h_compact_box;
}
QPushButton:hover {
    background-color: $surface_raised;
}
QPushButton:default {
    border: 1px solid $border_focus;
}
QPushButton:disabled {
    background-color: $surface_page;
    color: $text_disabled;
    border-color: $border_subtle;
}
QTableWidget, QTableView, QTreeWidget, QTreeView {
    background-color: $surface_input;
    border: 1px solid $border_default;
    border-radius: $radius_md;
    color: $text_secondary;
    font-size: $font_caption;
    gridline-color: $border_subtle;
}
QHeaderView::section {
    background-color: $surface_input;
    color: $text_disabled;
    border: none;
    border-right: 1px solid $border_subtle;
    padding: $space_1 $space_1;
    font-size: $font_caption;
    font-weight: 700;
}

/* ---------- 弹窗内 Tab（参数 / 判断标准分页） ----------
   卡片式：选中 tab 与 pane 同色同边框，pane 上移 1px 与 tab 咬合 */
QTabWidget::pane {
    background-color: $surface_card;
    border: 1px solid $border_default;
    border-radius: $radius_md;
    top: -1px;
}
QTabBar {
    background: transparent;
}
QTabBar::tab {
    background: transparent;
    color: $text_muted;
    font-size: $font_caption;
    padding: $space_1 $space_3;
    border: 1px solid transparent;
    border-bottom: none;
    border-top-left-radius: $radius_sm;
    border-top-right-radius: $radius_sm;
    margin-right: $space_1;
}
QTabBar::tab:hover:!selected {
    color: $text_secondary;
}
QTabBar::tab:selected {
    background-color: $surface_card;
    color: $text_primary;
    font-weight: 600;
    border: 1px solid $border_default;
    border-bottom: 1px solid $surface_card;
}

/* ---------- 判断标准表（#judgeCriteriaTable） ----------
   pane 卡片已提供外框：表体去边框透底，单元格编辑器去框防边框交叠 */
QTableWidget#judgeCriteriaTable {
    background: transparent;
    border: none;
    border-radius: 0;
    gridline-color: transparent;
}
QTableWidget#judgeCriteriaTable::item {
    border: none;
    border-bottom: 1px solid $border_subtle;
    padding-left: $space_2;
}
QTableWidget#judgeCriteriaTable QHeaderView::section {
    background-color: $surface_card;
    border: none;
    border-bottom: 1px solid $border_default;
    padding: $space_1 $space_2;
}
/* 单元格编辑器走 ID 选择器（cell widget 挂在 viewport 下，后代选择器不可靠）。
   hover/focus 仅改颜色不动几何：基态即 1px 透明 border（避免 focus 加边框 +2px），
   min/max-height 钉死（覆盖通用 QComboBox/QSpinBox 的 min-height，防 hover 时
   sizeHint 重算把行撑高溢出单元格）。行高 32px = 28px 编辑器 + 2×1px 边框。 */
#judgeCellEditor {
    background: transparent;
    border: 1px solid transparent;
    border-radius: $radius_sm;
    padding: 0 $space_2;
    min-height: $control_h_compact_box;
    max-height: $control_h_compact_box;
}
#judgeCellEditor:hover {
    background-color: $surface_raised;
}
#judgeCellEditor:focus {
    background-color: $surface_input;
    border-color: $border_focus;
}
